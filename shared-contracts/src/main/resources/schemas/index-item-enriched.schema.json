{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grocery-search.local/schemas/index-item-enriched.json",
  "title": "IndexItemEnriched",
  "description": "Normalized search document command consumed by search-indexer-service (demo v1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "tenant_id",
    "event_type",
    "event_version",
    "payload"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable idempotency key, e.g. tenant_id:store_id:sku"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": ["ItemSearchUpsert", "ItemSearchDelete"]
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sku", "name", "active"],
          "properties": {
            "sku": { "type": "string", "minLength": 1 },
            "store_id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "department": { "type": "string" },
            "active": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Delete: empty or marker object",
          "properties": {}
        }
      ]
    }
  }
}
